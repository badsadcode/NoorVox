<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.3.1</Version>
    <InformationalVersion>0.3.1</InformationalVersion>
    <Company>Bad Ideas Works</Company>
    <Product>NoorVox</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Windows-only product (named pipes ACLs, Job Objects, WPF later). x64 keeps ONNX Runtime natives unambiguous. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>
