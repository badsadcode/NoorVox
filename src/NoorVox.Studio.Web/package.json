{
  "name": "noorvox-studio-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NoorVox Studio UI (React + TypeScript), hosted by NoorVox.Studio in WebView2. `npm run dev` runs it in a browser against a mock bridge.",
