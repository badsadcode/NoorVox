<Window x:Class="NoorVox.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="NoorVox Studio" Width="1440" Height="900" MinWidth="980" MinHeight="640"
        Background="#12101C" WindowStartupLocation="CenterScreen">
    <!-- The title bar is part of the themed UI (TitleBar.tsx). WindowChrome removes Windows' caption but keeps the
         resize border, shadow, snapping and animations; WebView2 non-client regions (CSS app-region: drag) handle moving. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <!-- Margin 5 (set in FitMaximized) keeps a strip of the window itself around the WebView2: the web view is a child HWND
         that would otherwise take every mouse event at the edges, and the window could not be resized. -->
    <Grid x:Name="Root" Margin="5">
        <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#12101C" />
        <Border x:Name="Fallback" Visibility="Collapsed" Background="#12101C" Padding="48">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <TextBlock Text="NoorVox Studio can't start its interface" Foreground="#ECE9F7" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock x:Name="FallbackText" Foreground="#A59FC0" FontSize="14" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
